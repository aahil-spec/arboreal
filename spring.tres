[gd_resource type="Shader" format=3 uid="uid://ch31hb11kigvf"]

[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_always, cull_disabled, diffuse_burley, specular_schlick_ggx;

// --- COLORS ---
uniform vec3 shallow_color : source_color = vec3(0.0, 0.8, 0.8);
uniform vec3 deep_color : source_color = vec3(0.05, 0.1, 0.3);
uniform vec3 foam_color : source_color = vec3(1.0, 1.0, 1.0);

// --- DEPTH & FOAM ---
uniform float depth_distance : hint_range(0.0, 20.0, 0.1) = 8.0;
uniform float foam_distance : hint_range(0.0, 2.0, 0.1) = 0.5;

// --- WAVES ---
uniform float wave_scale = 20.0; // <-- NEW: Controls how densely packed the waves are!
uniform float wave_height = 0.8;
uniform float wave_speed = 1.2;
uniform sampler2D wave_texture_1;
uniform sampler2D wave_texture_2;
uniform vec2 wave_direction_1 = vec2(1.0, 0.2);
uniform vec2 wave_direction_2 = vec2(-0.5, 1.0);

// --- REFRACTION ---
uniform float refraction_strength : hint_range(0.0, 0.1, 0.001) = 0.015;

uniform sampler2D DEPTH_TEXTURE : hint_depth_texture, filter_linear_mipmap;
uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

void vertex() {
	float time = TIME * wave_speed * 0.05;
	// Multiply UV by wave_scale so the waves aren't stretched across the whole map
	float h1 = texture(wave_texture_1, UV * wave_scale + time * wave_direction_1).r;
	float h2 = texture(wave_texture_2, UV * wave_scale + time * wave_direction_2).r;
	
	VERTEX.y += (h1 + h2) * wave_height;
}

void fragment() {
	vec2 time1 = TIME * wave_speed * 0.05 * wave_direction_1;
	vec2 time2 = TIME * wave_speed * 0.08 * wave_direction_2;
	
	// Multiply UV here too so the normal maps match the physical waves
	vec3 normal1 = texture(wave_texture_1, UV * wave_scale + time1).rgb;
	vec3 normal2 = texture(wave_texture_2, UV * wave_scale + time2).rgb;
	
	vec3 blended_normal = mix(normal1, normal2, 0.5);

	float depth_raw = texture(DEPTH_TEXTURE, SCREEN_UV).x;
	vec3 ndc = vec3(SCREEN_UV, depth_raw) * 2.0 - 1.0;
	vec4 view = INV_PROJECTION_MATRIX * vec4(ndc, 1.0);
	view.xyz /= view.w;
	float linear_depth = -view.z;
	float surface_depth = -VERTEX.z;
	float depth_diff = max(0.0, linear_depth - surface_depth);

	float depth_blend = clamp(depth_diff / depth_distance, 0.0, 1.0);
	vec3 base_color = mix(shallow_color, deep_color, depth_blend);

	float foam_blend = clamp(depth_diff / foam_distance, 0.0, 1.0);
	float foam_noise = texture(wave_texture_1, UV * wave_scale * 2.0 + TIME * 0.1).r;
	float foam_threshold = step(foam_blend, 0.1 + foam_noise * 0.3);

	vec2 ref_ofs = blended_normal.xy * refraction_strength * depth_blend;
	vec3 ref_color = texture(SCREEN_TEXTURE, SCREEN_UV + ref_ofs).rgb;

	vec3 final_color = mix(ref_color * base_color, base_color, 0.6); 
	final_color = mix(final_color, foam_color, foam_threshold);

	ALBEDO = final_color;
	NORMAL_MAP = blended_normal;
	ROUGHNESS = 0.05;
	METALLIC = 0.85;
}"
